  "scenarios": [
    {
      "key": "S1",
      "name": "Main flow",
      "steps": [
        {
          "step": 1,
          "actor": "01",
          "action": "paste the use case",
          "edge": "IF-01",
          "target": "02"
        },
        {
          "step": 2,
          "actor": "02",
          "action": "split it into business steps, shown to the architect",
          "edge": "IF-03",
          "target": "06"
        },
        {
          "step": 3,
          "actor": "02",
          "action": "retrieve candidate service domains for each step",
          "edge": "IF-02",
          "target": "03"
        },
        {
          "step": 4,
          "actor": "02",
          "action": "choose among the candidates only, with reasons",
          "edge": "IF-03",
          "target": "06"
        },
        {
          "step": 5,
          "actor": "02",
          "action": "fetch the chosen domains' operations and business objects",
          "edge": "IF-02",
          "target": "03"
        },
        {
          "step": 6,
          "actor": "02",
          "action": "show steps, domains, interfaces and data sets, each with its reference model id, and the gaps",
          "edge": "IF-01",
          "target": "01"
        }
      ]
    },
    {
      "key": "S2",
      "name": "Load a reference model release",
      "steps": [
        {
          "step": 1,
          "actor": "05",
          "action": "read the release's API files",
          "edge": "IF-04",
          "target": "04"
        },
        {
          "step": 2,
          "actor": "05",
          "action": "load the ontology, its provenance and definition vectors",
          "edge": "IF-05",
          "target": "03"
        }
      ]
    }
  ],

{
  "name": "UC-900 Map a business use case to an industry reference model",
  "version": "0.1",
  "source": "index.md",
  "nodes": [
    {
      "id": "01",
      "label": "Architect",
      "group": "actor",
      "attrs": {
        "role_in_this_use_case": "Pastes the use case, corrects the steps, reviews the answer"
      }
    },
    {
      "id": "02",
      "label": "Use-case chat",
      "group": "solution",
      "attrs": {
        "role_in_this_use_case": "Splits the use case into steps and assembles the answer through read-only tools"
      }
    },
    {
      "id": "03",
      "label": "Reference model graph",
      "group": "solution",
      "attrs": {
        "role_in_this_use_case": "Service domains, operations and business objects in a graph database, with definition embeddings"
      }
    },
    {
      "id": "04",
      "label": "Reference model APIs",
      "group": "external",
      "attrs": {
        "role_in_this_use_case": "Published OpenAPI files under an open licence"
      }
    },
    {
      "id": "05",
      "label": "Ontology distiller",
      "group": "solution",
      "attrs": {
        "role_in_this_use_case": "Turns the API files into OWL with provenance"
      }
    },
    {
      "id": "06",
      "label": "Model service",
      "group": "external",
      "attrs": {
        "role_in_this_use_case": "Splits steps, chooses among candidates, writes the answer"
      }
    }
  ],

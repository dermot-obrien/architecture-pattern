{
  "name": "architecture-pattern",
  "description": "The architecture-pattern bundle's skills, one package per skill.",
  "owner": {
    "name": "Dermot O'Brien",
    "url": "https://github.com/dermot-obrien"
  },
  "allowCrossMarketplaceDependenciesOn": [
    "diagram-model",
    "markdown-deck"
  ],
  "plugins": [
    {
      "name": "pattern",
      "source": "./",
      "strict": false,
      "description": "Author an architecture pattern at any scope as one Markdown document that is also the model and the deck: the draw.io diagram and scenario overlays are generated from its tables and validated against it, and its tagged sections publish as HTML slides and a PDF.",
      "version": "0.10.3",
      "author": {
        "name": "Dermot O'Brien",
        "url": "https://github.com/dermot-obrien"
      },
      "homepage": "https://github.com/dermot-obrien/architecture-pattern",
      "repository": "https://github.com/dermot-obrien/architecture-pattern",
      "license": "CC-BY-4.0 AND Apache-2.0",
      "keywords": [
        "architecture",
        "pattern",
        "reference-architecture",
        "drawio",
        "togaf",
        "c4",
        "agent-skill"
      ],
      "category": "documentation",
      "skills": [
        "./skills/pattern"
      ],
      "dependencies": [
        {
          "name": "model",
          "version": "^0.8.0",
          "marketplace": "diagram-model"
        },
        {
          "name": "markdown-deck",
          "version": "^0.6.0",
          "marketplace": "markdown-deck"
        }
      ]
    },
    {
      "name": "use-case",
      "source": "./",
      "strict": false,
      "description": "Author a use case as one Markdown document that is also the model and the deck: what a solution does for someone and what it needs, before anyone designs how it is built. Its participants and interactions generate the draw.io diagram and an animated walkthrough of the main flow, and its tagged sections publish as HTML slides and a PDF.",
      "version": "0.2.0",
      "author": {
        "name": "Dermot O'Brien",
        "url": "https://github.com/dermot-obrien"
      },
      "homepage": "https://github.com/dermot-obrien/architecture-pattern",
      "repository": "https://github.com/dermot-obrien/architecture-pattern",
      "license": "CC-BY-4.0 AND Apache-2.0",
      "keywords": [
        "architecture",
        "use-case",
        "requirements",
        "drawio",
        "agent-skill"
      ],
      "category": "documentation",
      "skills": [
        "./skills/use-case"
      ],
      "dependencies": [
        {
          "name": "pattern",
          "version": "^0.10.3"
        },
        {
          "name": "model",
          "version": "^0.8.2",
          "marketplace": "diagram-model"
        },
        {
          "name": "markdown-deck",
          "version": "^0.6.0",
          "marketplace": "markdown-deck"
        }
      ]
    },
    {
      "name": "cross-reference",
      "source": "./",
      "strict": false,
      "description": "Refer to another catalogue's architecture identifiers without clashes: a bare ABB-024 means this catalogue, ops:ABB-024 means the catalogue whose short code is ops. Validates the namespace and identifier registers, resolves and checks references, and ships Docusaurus plugins for links, stable identifier addresses and a manifest.",
      "version": "0.1.1",
      "author": {
        "name": "Dermot O'Brien",
        "url": "https://github.com/dermot-obrien"
      },
      "homepage": "https://github.com/dermot-obrien/architecture-pattern",
      "repository": "https://github.com/dermot-obrien/architecture-pattern",
      "license": "CC-BY-4.0 AND Apache-2.0",
      "keywords": [
        "architecture",
        "identifiers",
        "cross-reference",
        "curie",
        "docusaurus",
        "agent-skill"
      ],
      "category": "documentation",
      "skills": [
        "./skills/cross-reference"
      ]
    }
  ]
}

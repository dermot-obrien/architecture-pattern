{
  "$schema": "pkg:generic/dermot-obrien/ai-assisted-work/bundle-schema@1.0.0",
  "name": "architecture-pattern",
  "owner": "dermot-obrien",
  "description": "Author an architecture pattern, or the use case it serves, as one Markdown document that is also the model and also the deck, at any scope from one recurring problem to a whole domain.",
  "license": "CC-BY-4.0 AND Apache-2.0",
  "homepage": "https://github.com/dermot-obrien/architecture-pattern",
  "derived_from": [
    "https://github.com/dermot-obrien/ai-assisted-architecture/tree/5a1c13860ad5093125afb3c41a82793e084cc0b7/skills/pattern"
  ],
  "skills": [
    {
      "name": "pattern",
      "path": "skills/pattern",
      "version": "0.14.0",
      "purl": "pkg:generic/dermot-obrien/architecture-pattern/pattern@0.14.0",
      "requires": [
        { "purl": "pkg:generic/dermot-obrien/diagram-model/model", "range": "^0.9.0" },
        { "purl": "pkg:generic/dermot-obrien/markdown-deck/markdown-deck", "range": "^0.6.0" }
      ],
      "check": {
        "command": [
          "python",
          "scripts/check.py"
        ],
        "runtime": "python",
        "description": "model and markdown-deck are installed, and model doctor --skill pattern passes on the [suite.pattern] bindings"
      }
    },
    {
      "name": "use-case",
      "path": "skills/use-case",
      "version": "0.4.0",
      "purl": "pkg:generic/dermot-obrien/architecture-pattern/use-case@0.4.0",
      "requires": [
        { "purl": "pkg:generic/dermot-obrien/architecture-pattern/pattern", "range": "^0.14.0" },
        { "purl": "pkg:generic/dermot-obrien/diagram-model/model", "range": "^0.9.0" },
        { "purl": "pkg:generic/dermot-obrien/markdown-deck/markdown-deck", "range": "^0.6.0" }
      ],
      "check": {
        "command": [
          "python",
          "scripts/check.py"
        ],
        "runtime": "python",
        "description": "pattern, model and markdown-deck are installed, and model doctor --skill use-case passes on the [suite.use-case] bindings"
      }
    },
    {
      "name": "cross-reference",
      "path": "skills/cross-reference",
      "version": "0.3.1",
      "purl": "pkg:generic/dermot-obrien/architecture-pattern/cross-reference@0.3.1",
      "requires": [],
      "check": {
        "command": [
          "node",
          "scripts/check.cjs"
        ],
        "runtime": "node",
        "description": "[suite.cross-reference] binds the namespace register, every register row passes the rules, and the catalogue's identifier map loads"
      }
    },
    {
      "name": "portfolio",
      "path": "skills/portfolio",
      "version": "0.1.0",
      "purl": "pkg:generic/dermot-obrien/architecture-pattern/portfolio@0.1.0",
      "requires": [
        { "purl": "pkg:generic/dermot-obrien/architecture-pattern/pattern", "range": "^0.14.0" },
        { "purl": "pkg:generic/dermot-obrien/architecture-pattern/use-case", "range": "^0.4.0" }
      ],
      "check": {
        "command": [
          "python",
          "scripts/check.py"
        ],
        "runtime": "python",
        "description": "[suite.portfolio] resolves, the pattern and use-case skills are found for placeholders, and every signed document passes portfolio.py check"
      }
    },
    {
      "name": "draft",
      "path": "skills/draft",
      "version": "0.1.0",
      "purl": "pkg:generic/dermot-obrien/architecture-pattern/draft@0.1.0",
      "requires": [
        { "purl": "pkg:generic/dermot-obrien/architecture-pattern/portfolio", "range": "^0.1.0" }
      ],
      "check": {
        "command": [
          "python",
          "scripts/check.py"
        ],
        "runtime": "python",
        "description": "the portfolio skill is installed, and the placeholders and drafts are listed"
      }
    }
  ],
  "adapters": {
    "claude-plugin": ".claude-plugin/marketplace.json"
  }
}
